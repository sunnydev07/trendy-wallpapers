# =============================================================================
# Trendy-Wallpapers Environment Variables
# Leave Supabase/R2/Upstash/Fal blank to boot cleanly in Local Demo Mode!
# =============================================================================

# Site Canonical URL (used in sitemap.ts, robots.ts, JSON-LD, and OpenGraph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google AdSense Publisher ID (e.g. ca-pub-1234567890123456)
# Leave blank during development to show CLS-reserved preview placeholders
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Supabase (PostgreSQL + Auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (Zero-Egress S3-Compatible Object Storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=trendy-wallpapers
NEXT_PUBLIC_R2_PUBLIC_URL=

# Upstash Redis (Rate Limiting: 2/day guest, 5/day authed + Daily AI Spend Cap)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
IP_HASH_SALT=replace-with-a-random-32-char-secret

# Fal.ai (AI Wallpaper Studio — defaults to fal-ai/flux/schnell)
FAL_KEY=
DAILY_AI_BUDGET_USD=5.00

# Admin Upload API Bearer Secret (minimum 16 characters)
ADMIN_UPLOAD_SECRET=replace-with-a-strong-admin-secret
